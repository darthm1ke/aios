[Unit]
Description=ArchSpeech AI Daemon
# NO network dependency - the local model needs nothing from the internet.
# Waiting on network-online here is what stalled boot on offline machines.
# We order after ollama so the first request has a backend, but we do NOT
# require it: the socket must come up ASAP so the UI never blocks.
After=ollama.service
Wants=ollama.service

[Service]
Type=simple
User=archspeech
Group=archspeech
ExecStart=/usr/local/bin/archspeech-daemon
Restart=on-failure
RestartSec=5
RuntimeDirectory=archspeech
RuntimeDirectoryMode=0755
LogsDirectory=archspeech
StandardOutput=journal
StandardError=journal
SyslogIdentifier=archspeech

[Install]
WantedBy=multi-user.target
