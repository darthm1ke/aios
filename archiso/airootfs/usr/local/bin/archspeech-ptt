#!/opt/archspeech/bin/python3
"""
ArchSpeech Push-to-Talk daemon — SOLE OWNER of the microphone.

Why this version: a raw ALSA capture device (plughw) is single-client. If the
dashboard meters the mic continuously AND this daemon tries to open it to
record, the second one is blocked ("device busy") and records silence. So this
daemon is the ONLY process that opens the mic: it reads one continuous arecord
stream, always publishes the live level (for the dashboard bar) to
/run/archspeech/mic_level, and — while a PTT key is held — also buffers the
audio, then transcribes it on release.

Keys: Caps Lock (keyd remaps it to F13) and Right Ctrl.
"""

import asyncio, subprocess, os, sys, logging, re, wave, struct, threading, time, tempfile
from pathlib import Path

import evdev
from evdev import InputDevice, ecodes

VOICE_FIFO    = "/run/archspeech/voice_input"
STATUS_PATH   = Path("/run/archspeech/ptt_status")
LEVEL_PATH    = Path("/run/archspeech/mic_level")
LOG_PATH      = Path("/var/log/archspeech/ptt.log")
WHISPER_CACHE = "/root/.cache/whisper"
WHISPER_SIZE  = "base"
RATE          = 16000
SILENCE_RMS   = 120

LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
logging.basicConfig(filename=str(LOG_PATH), level=logging.INFO,
                    format="%(asctime)s [PTT] %(message)s")
log = logging.getLogger("archspeech.ptt")

def status(msg):
    log.info(msg)
    try:
        STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
        STATUS_PATH.write_text(msg)
    except Exception:
        pass
    print(f"[PTT] {msg}", flush=True)

# ── shared recording state (audio thread <-> key loop) ───────────────────────
REC   = {"on": False, "buf": bytearray()}
RLOCK = threading.Lock()

def rms16(raw):
    n = len(raw) // 2
    if n == 0:
        return 0
    samples = struct.unpack(f"{n}h", raw[:n*2])
    return int((sum(s*s for s in samples) / n) ** 0.5)

# ── capture device (raw hw, bypass pipewire default) ─────────────────────────
def capture_device():
    try:
        out = subprocess.run(["arecord", "-l"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"card (\d+):.*?device (\d+):", out)
        if m:
            return f"plughw:{m.group(1)},{m.group(2)}", m.group(1)
    except Exception as e:
        log.error(f"arecord -l failed: {e}")
    return "default", "0"

def unmute(card):
    for ctl in ("Capture", "Mic", "Internal Mic", "Mic Boost", "Master"):
        subprocess.run(["amixer", "-c", card, "sset", ctl, "cap"], capture_output=True)
        subprocess.run(["amixer", "-c", card, "sset", ctl, "80%", "unmute"], capture_output=True)

DEVICE, CARD = capture_device()

def audio_reader():
    """The ONLY opener of the mic. Always publishes level; buffers while recording."""
    while True:
        try:
            p = subprocess.Popen(
                ["arecord", "-D", DEVICE, "-f", "S16_LE", "-r", str(RATE), "-c", "1", "-t", "raw", "-q"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            while True:
                data = p.stdout.read(2048)
                if not data:
                    break
                try: LEVEL_PATH.write_text(str(rms16(data)))
                except Exception: pass
                with RLOCK:
                    if REC["on"]:
                        REC["buf"] += data
        except Exception as e:
            log.error(f"audio reader died: {e}")
            time.sleep(1)

def write_wav(path, raw):
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
        w.writeframes(raw)

# ── Whisper (resident) ───────────────────────────────────────────────────────
_WHISPER = None
def load_whisper():
    global _WHISPER
    try:
        import whisper
        status("loading Whisper (offline)...")
        _WHISPER = whisper.load_model(WHISPER_SIZE, download_root=WHISPER_CACHE)
        status("ready — hold Caps Lock to talk")
    except Exception as e:
        status(f"Whisper load FAILED: {e}")
        _WHISPER = None

def transcribe(wav_path):
    if _WHISPER is None:
        return ""
    try:
        r = _WHISPER.transcribe(wav_path, fp16=False, language="en")
        return (r.get("text") or "").strip()
    except Exception as e:
        log.error(f"transcribe error: {e}")
        return ""

def beep(freq, ms):
    subprocess.Popen(["speaker-test", "-t", "sine", "-f", str(freq), "-l", "1", "-P", str(ms)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def to_ui(text):
    try:
        if not os.path.exists(VOICE_FIFO):
            os.mkfifo(VOICE_FIFO)
        fd = os.open(VOICE_FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (text + "\n").encode())
        os.close(fd)
    except Exception as e:
        log.error(f"FIFO write failed (dashboard not reading?): {e}")

# ── keyboard ─────────────────────────────────────────────────────────────────
PTT_KEYS = {ecodes.KEY_F13, ecodes.KEY_RIGHTCTRL}   # F13 = keyd-remapped Caps Lock

def find_keyboards():
    kbs = []
    for path in evdev.list_devices():
        try:
            dev = InputDevice(path)
            keys = dev.capabilities().get(ecodes.EV_KEY, [])
            if any(k in keys for k in PTT_KEYS):
                kbs.append(dev); log.info(f"watching {dev.name} ({path})")
        except Exception:
            pass
    return kbs

async def watch(kbd):
    async for ev in kbd.async_read_loop():
        if ev.type != ecodes.EV_KEY or ev.code not in PTT_KEYS:
            continue
        if ev.value == 1:                               # key down
            with RLOCK:
                REC["buf"] = bytearray(); REC["on"] = True
            status("listening..."); beep(880, 80)
        elif ev.value == 0:                             # key up
            with RLOCK:
                REC["on"] = False; raw = bytes(REC["buf"]); REC["buf"] = bytearray()
            beep(440, 80)
            level = rms16(raw)
            if len(raw) < RATE or level < SILENCE_RMS:   # <0.5s or silent
                status(f"silence (level {level}) — speak while holding the key")
                continue
            status(f"transcribing ({level})...")
            wav = tempfile.mktemp(suffix=".wav", dir="/tmp")
            write_wav(wav, raw)
            text = transcribe(wav)
            try: os.unlink(wav)
            except Exception: pass
            if text:
                status(f"heard: {text}"); to_ui(text)
            else:
                status("transcription empty")

async def main():
    status(f"capture device {DEVICE} (card {CARD})")
    unmute(CARD)
    threading.Thread(target=audio_reader, daemon=True).start()
    load_whisper()
    kbs = find_keyboards()
    if not kbs:
        status("no PTT keyboard found (F13/Right Ctrl) — keyd running?")
        while True:
            await asyncio.sleep(5)
    await asyncio.gather(*[watch(k) for k in kbs])

if __name__ == "__main__":
    asyncio.run(main())
