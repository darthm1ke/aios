#!/opt/archspeech/bin/python3
"""
AIos Dashboard — ANSI-based, works on VGA console, X11, Wayland, SSH.
No curses dependency — pure escape codes for maximum compatibility.

Rendering: cursor-home overwrite (NOT full-screen clear) so the console never
flickers and typing is never swallowed. Terminal size comes from a cheap ioctl
(os.get_terminal_size), never a `tput` subprocess.

AI: responses STREAM token-by-token in a background thread, so the UI keeps
redrawing while the model thinks and you can see it working in real time.
"""

import asyncio, subprocess, threading, time, os, sys, select, textwrap
import json, urllib.request, struct, math, re
from pathlib import Path

SOCKET_PATH = "/run/archspeech/daemon.sock"
STATUS_FILE = Path("/var/lib/aios/model_status")
READY_FLAG  = Path("/var/lib/aios/.model_ready")
VOICE_FIFO  = Path("/run/archspeech/voice_input")
CHEAT_DIR   = Path("/etc/archspeech/cheatsheets")
MODEL       = "qwen2.5:0.5b"

# ── ANSI helpers ────────────────────────────────────────────────────────────
def bold(s):     return f"\033[1m{s}\033[0m"
def cyan(s):     return f"\033[1;36m{s}\033[0m"
def green(s):    return f"\033[0;32m{s}\033[0m"
def yellow(s):   return f"\033[0;33m{s}\033[0m"
def red(s):      return f"\033[0;31m{s}\033[0m"
def dim(s):      return f"\033[0;90m{s}\033[0m"

def bar(pct, w, fill="█", empty="░"):
    f = int(w * pct / 100)
    return fill * f + empty * (w - f)

def mic_bar(level, w):
    f = int(w * level)
    return "▄" * f + " " * (w - f)

def box(title, content_lines, width):
    top    = f"┌ {title} {'─' * max(0, width - len(title) - 4)}┐"
    bottom = "└" + "─" * (width - 2) + "┘"
    lines  = [top]
    for line in content_lines:
        padded = line[:width-4]
        lines.append(f"│ {padded:<{width-4}} │")
    lines.append(bottom)
    return lines

def term_size():
    try:
        sz = os.get_terminal_size(sys.stdout.fileno())
        return sz.columns, sz.lines
    except Exception:
        return 80, 24

# ── Cheat sheets: the 0.5B model can't recall Arch commands alone, so we give
#    it ALL of them in the system prompt (they total ~1.2K tokens). ────────────
def load_cheats():
    # Focus the tiny model on the INSTALLER mission only — loading pentest/web/
    # service sheets just adds noise that derails a 0.5B. Order = priority.
    parts = []
    for name in ("networking.md", "install.md", "packages.md"):
        p = CHEAT_DIR / name
        if p.exists():
            try: parts.append(p.read_text().strip())
            except Exception: pass
    return "\n\n".join(parts)

SYSTEM_PROMPT = (
    "You are AIos, the AI assistant on a live USB. Your ONE mission: help the user "
    "install this OS onto their computer. Two phases:\n"
    "  1. GET THEM ONLINE first (installing needs internet). Follow the networking "
    "guide — try the easiest path, run one command, read the result, continue.\n"
    "  2. INSTALL: ask which disk (run 'lsblk -dno NAME,SIZE,MODEL'), wipe-or-"
    "alongside, and which desktop (gnome/kde/xfce/minimal). Then run the vetted "
    "'aios-install' command from the install guide. ALWAYS run it WITHOUT --yes "
    "first to show the plan, let the user confirm, THEN run again with --yes.\n\n"
    "To run a command, put it ALONE in a fenced bash block — it executes on the "
    "real machine as root and you get its output back:\n"
    "```bash\nlsblk -dno NAME,SIZE,MODEL\n```\n"
    "Rules: NEVER hand-write parted/pacstrap — use aios-install. Use ONLY real "
    "Arch package names. One short sentence before each command block. Be concise.\n\n"
    "=== COMMAND REFERENCE (use these exact commands) ===\n" + load_cheats()
)

# ── Shared state ────────────────────────────────────────────────────────────
S = {
    "mic":        0.0,
    "vol":        80,
    "gpu":        0,
    "bat":        -1,
    "bat_chg":    False,
    "cpu":        0,
    "ram_used":   0,
    "ram_total":  0,
    "net_up":     0,
    "net_down":   0,
    "ai_status":  "Starting...",
    "ai_ready":   False,
    "ptt_status": "",
    "voice_q":    [],
    "recording":  False,
    # streaming response state
    "ai_partial": "",
    "ai_busy":    False,
    "ai_done":    False,
}
SL = threading.Lock()

# ── Hardware ──────────────────────────────────────────────────────────────────
def hw_thread():
    while True:
        try:
            for b in ["BAT0","BAT1"]:
                p = Path(f"/sys/class/power_supply/{b}/capacity")
                if p.exists():
                    pct = int(p.read_text())
                    chg = Path(f"/sys/class/power_supply/{b}/status").read_text().strip() == "Charging"
                    with SL: S["bat"] = pct; S["bat_chg"] = chg
                    break
            for g in Path("/sys/class/drm").glob("card*/gt_cur_freq_mhz"):
                mx = g.parent / "gt_max_freq_mhz"
                if mx.exists():
                    pct = int(int(g.read_text()) / int(mx.read_text()) * 100)
                    with SL: S["gpu"] = pct
                    break
            with open("/proc/stat") as f:
                vals = list(map(int, f.readline().split()[1:]))
            idle, total = vals[3], sum(vals)
            if not hasattr(hw_thread, "prev"):
                hw_thread.prev = (idle, total)
            pi, pt = hw_thread.prev; hw_thread.prev = (idle, total)
            di, dt = idle-pi, total-pt
            with SL: S["cpu"] = int((1 - di/dt)*100) if dt else 0
            info = {}
            with open("/proc/meminfo") as f:
                for line in f:
                    k, v = line.split(":")
                    info[k.strip()] = int(v.split()[0])
            rt = info.get("MemTotal",0)//1024
            ru = rt - info.get("MemAvailable",0)//1024
            with SL: S["ram_used"] = ru; S["ram_total"] = rt
            # Volume via amixer is a subprocess spawn — poll it only every ~5s,
            # not every second, so it never competes with the input loop.
            hw_thread.tick = getattr(hw_thread, "tick", 0) + 1
            if hw_thread.tick % 5 == 1:
                try:
                    r = subprocess.run(["amixer","get","Master"], capture_output=True, text=True, timeout=1)
                    for line in r.stdout.split("\n"):
                        if "%" in line:
                            vol = int(line.split("[")[1].split("%")[0])
                            with SL: S["vol"] = vol
                            break
                except Exception: pass
            st = STATUS_FILE.read_text().strip() if STATUS_FILE.exists() else ""
            rdy = READY_FLAG.exists() or ai_available()
            pst = ""
            try:
                pp = Path("/run/archspeech/ptt_status")
                if pp.exists(): pst = pp.read_text().strip()
            except Exception: pass
            with SL: S["ai_status"] = st; S["ai_ready"] = rdy; S["ptt_status"] = pst
        except Exception: pass
        time.sleep(1)

def mic_thread():
    """The PTT daemon is the SOLE owner of the mic (a raw ALSA device is
    single-client) and publishes the live level to /run/archspeech/mic_level.
    We just read that file — no contention with the PTT's recording."""
    lp = Path("/run/archspeech/mic_level")
    while True:
        try:
            lvl = int(lp.read_text().strip()) if lp.exists() else 0
            with SL: S["mic"] = min(1.0, lvl / 3000)
        except Exception:
            with SL: S["mic"] = 0.0
        time.sleep(0.1)

def voice_thread():
    try:
        if not VOICE_FIFO.exists():
            os.mkfifo(str(VOICE_FIFO))
        while True:
            with open(VOICE_FIFO) as f:
                line = f.read().strip()
                if line:
                    with SL: S["voice_q"].append(line)
    except Exception: pass

# ── AI ────────────────────────────────────────────────────────────────────────
def ai_available():
    try:
        urllib.request.urlopen("http://localhost:11434/api/version", timeout=1)
        return True
    except Exception: return False

OPTS = {"num_ctx":4096,"temperature":0.4,"num_predict":256,"repeat_penalty":1.3,"num_gpu":0}

def _emit(s):
    """Append text to the live AI message the dashboard is rendering."""
    with SL: S["ai_partial"] += s

def _chat_stream(convo):
    """Stream one /api/chat round into the live message; return the full text."""
    payload = json.dumps({"model":MODEL,"messages":convo,"stream":True,"options":OPTS}).encode()
    req = urllib.request.Request("http://localhost:11434/api/chat",
        data=payload, headers={"Content-Type":"application/json"}, method="POST")
    full = ""
    with urllib.request.urlopen(req, timeout=300) as resp:
        for raw in resp:
            raw = raw.strip()
            if not raw: continue
            try: evt = json.loads(raw)
            except Exception: continue
            tok = evt.get("message",{}).get("content","")
            if tok:
                full += tok
                with SL: S["ai_partial"] += tok
            if evt.get("done"): break
    return full

def extract_commands(text):
    """Pull executable command lines out of ```bash fenced code blocks."""
    cmds = []
    # Require an explicit bash/sh tag — untagged ``` blocks are usually the
    # model showing example OUTPUT, not commands to run. Don't execute those.
    for block in re.findall(r"```(?:bash|sh|shell|console)\s*\n?(.*?)```", text, re.S):
        for line in block.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            line = re.sub(r"^\$\s+", "", line)   # strip a leading "$ " prompt
            cmds.append(line)
    return cmds

def _run_cmd(cmd):
    """Execute a command as root (the dashboard IS root on tty1). Full control.
    stdin is /dev/null so interactive prompts get EOF instead of hanging."""
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=300, stdin=subprocess.DEVNULL)
        out = (r.stdout or "") + (("\n"+r.stderr) if r.stderr else "")
        return out.strip() or f"(exit {r.returncode}, no output)"
    except subprocess.TimeoutExpired:
        return "(command timed out after 300s)"
    except Exception as e:
        return f"(error: {e})"

def run_ai(msg):
    """Agent loop for a tiny model: the model writes commands in ```bash blocks,
    we stream its reply, then execute every command as root and feed the output
    back so it can continue or summarize. Commands + output appear live."""
    convo = [{"role":"system","content":SYSTEM_PROMPT},
             {"role":"user","content":msg}]
    try:
        for _ in range(4):                       # cap rounds to avoid loops
            text = _chat_stream(convo)
            convo.append({"role":"assistant","content":text})
            cmds = extract_commands(text)
            if not cmds:
                if not S["ai_partial"].strip():
                    _emit("(no response — try rephrasing)")
                break
            results = []
            for cmd in cmds:
                _emit(f"\n⚙ $ {cmd}\n")
                out = _run_cmd(cmd)
                _emit("  " + out.replace("\n", "\n  ")[:1200] + "\n")
                results.append(f"$ {cmd}\n{out[:1500]}")
            convo.append({"role":"user","content":
                "Output of the commands you ran:\n" + "\n\n".join(results) +
                "\n\nIf the task is done, reply with one short sentence and NO code block. "
                "If more commands are needed, output the next ```bash block."})
            _emit("\n")
    except Exception as e:
        _emit(f"\n[error reaching model: {e}]")
    finally:
        with SL: S["ai_done"] = True

def fmt_bytes(b):
    if b < 1024: return f"{b}B/s"
    if b < 1048576: return f"{b//1024}K/s"
    return f"{b//1048576}M/s"

# ── Conversation wrapping ──────────────────────────────────────────────────────
def conversation_lines(messages, width):
    """Flatten messages into wrapped display lines, tagged with role for color."""
    out = []
    avail = max(20, width - 4)
    for role, text in messages:
        text = " ".join(str(text).split())  # collapse newlines/whitespace
        prefix = f"  {role}: "
        wrapped = textwrap.wrap(text, width=max(10, avail - len(prefix)),
                                break_long_words=True) or [""]
        out.append((role, prefix + wrapped[0]))
        for cont in wrapped[1:]:
            out.append((role, "      " + cont))
    return out

# ── Render ────────────────────────────────────────────────────────────────────
def render(messages, input_buf, busy):
    cols, rows = term_size()

    with SL:
        mic   = S["mic"]; vol = S["vol"]; gpu = S["gpu"]
        bat   = S["bat"]; bat_chg = S["bat_chg"]; cpu = S["cpu"]
        ru    = S["ram_used"]; rt = S["ram_total"]
        nu    = S["net_up"]; nd = S["net_down"]
        ai_st = S["ai_status"]; ai_rdy = S["ai_ready"]
        rec   = S["recording"]; pst = S["ptt_status"]

    out = []

    # ── Row 1: mic | speaker | gpu | battery ─────────────────────────────────
    half = cols // 2; q = cols // 4; eq = cols - q*3
    mic_title = "microphone 🔴" if rec else "microphone"
    bw = q - 8
    mic_lines  = [f"{mic_bar(mic, bw)} {int(mic*100):3d}%"]
    spk_lines  = [f"{bar(vol, bw)} {vol:3d}%"]
    gpu_lines  = [f"{bar(gpu, 4)} {gpu:3d}%"]
    bat_label  = f"{bat}% ⚡" if bat_chg else f"{bat}%" if bat >= 0 else "N/A"
    bat_color  = green if bat > 50 else yellow if bat > 20 else red
    bat_lines  = [bat_color(bat_label)]

    row1_boxes = [
        box(mic_title, mic_lines, q),
        box("speaker", spk_lines, q),
        box("gpu", gpu_lines, q),
        box("battery", bat_lines, eq),
    ]
    for i in range(3):
        line = ""
        for b_lines in row1_boxes:
            line += b_lines[i] if i < len(b_lines) else ""
        out.append(line[:cols])

    # ── Row 2: ai status | system ─────────────────────────────────────────────
    if ai_rdy:
        ai_lines = [green(f"{MODEL}  ready ✓"), dim("Type a question + Enter, or hold Caps Lock to speak")]
    else:
        pct = 0
        if "%" in ai_st:
            try: pct = int(ai_st.split("%")[0].split()[-1])
            except Exception: pass
        bw2 = half - 8
        ai_lines = [(ai_st or "Loading model...")[:half-4], f"{bar(pct, bw2)} {pct}%"]

    sw = cols - half
    sys_lines = [
        f"CPU {cpu:3d}%  {bar(cpu, sw-12)}",
        f"RAM {ru}MB / {rt}MB",
        f"NET ↑{fmt_bytes(nu)}  ↓{fmt_bytes(nd)}",
    ]
    ai_box  = box("ai model", ai_lines, half)
    sys_box = box("system",   sys_lines, sw)
    for i in range(4):
        al = ai_box[i]  if i < len(ai_box)  else " " * half
        sl = sys_box[i] if i < len(sys_box) else ""
        out.append((al + sl)[:cols])

    # ── Conversation (wrapped, scrolled to the tail) ───────────────────────────
    conv_h = max(1, rows - len(out) - (5 if pst else 4))
    out.append("┌" + " conversation ".center(cols-2, "─") + "┐")
    disp = conversation_lines(messages, cols)
    visible = disp[-conv_h:]
    for role, line in visible:
        colored = cyan(line[:cols-4]) if role == "AI" else green(line[:cols-4])
        out.append("│" + colored.ljust(cols-2) + "│")
    for _ in range(conv_h - len(visible)):
        out.append("│" + " "*(cols-2) + "│")
    out.append("└" + "─"*(cols-2) + "┘")

    # ── Input bar ─────────────────────────────────────────────────────────────
    if busy:
        out.append((dim("  (AI is responding — please wait)"))[:cols+20])
    else:
        out.append(("  You: " + input_buf)[:cols])
    if pst:
        out.append(yellow(f"  🎤 voice: {pst}")[:cols+30])
    out.append(dim("  [Caps Lock] speak  │  [Right Ctrl] VM  │  [Enter] send  │  [Esc] quit")[:cols+20])

    # ── Flicker-free paint: home, overwrite each line, clear trailing ──────────
    # \r\n (not \n): raw mode disables newline translation, so we emit CR+LF
    # ourselves or every line would stair-step across the screen.
    buf = ["\033[H"]
    for line in out[:rows]:
        buf.append(line + "\033[K\r\n")
    buf.append("\033[J")  # wipe anything left below the frame
    sys.stdout.write("".join(buf))
    sys.stdout.flush()

# ── Main ──────────────────────────────────────────────────────────────────────
async def main():
    threading.Thread(target=hw_thread,    daemon=True).start()
    threading.Thread(target=mic_thread,   daemon=True).start()
    threading.Thread(target=voice_thread, daemon=True).start()

    if ai_available():
        messages = [("AI", "I'm ready. What would you like to do?")]
    else:
        messages = [("AI", "Starting up — the model is loading, one moment...")]

    input_buf = ""
    os.system("tput civis 2>/dev/null")               # hide cursor
    os.system("setterm -blank 0 -powersave off 2>/dev/null")  # no console blanking
    sys.stdout.write("\033[2J\033[H")                 # one clean clear at startup only
    sys.stdout.flush()

    import termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setraw(fd)                 # raw ONCE — toggling it every frame raced with input
    last_render = 0.0
    dirty = True                   # repaint flag: set on any state change
    try:
        while True:
            # voice transcripts arrive via FIFO → drop into the input line
            with SL:
                vq = S["voice_q"][:]; S["voice_q"].clear()
                busy = S["ai_busy"]; partial = S["ai_partial"]; done = S["ai_done"]
            # A spoken transcript (from the PTT daemon via FIFO) is submitted to
            # the AI exactly like typing it and pressing Enter.
            if vq and not busy:
                spoken = vq[-1].strip()
                if spoken:
                    input_buf = ""
                    messages.append(("You", spoken))
                    messages.append(("AI", ""))
                    with SL:
                        S["ai_partial"] = ""; S["ai_busy"] = True; S["ai_done"] = False
                    threading.Thread(target=run_ai, args=(spoken,), daemon=True).start()
                    busy = True
                dirty = True

            # merge streamed tokens into the last (AI) message
            if busy:
                if partial:
                    messages[-1] = ("AI", partial)
                else:
                    spin = "|/-\\"[int(time.time()*5) % 4]
                    messages[-1] = ("AI", f"thinking {spin}")
                if done:
                    messages[-1] = ("AI", partial.strip() or "(no response)")
                    with SL: S["ai_busy"] = False
                    busy = False
                dirty = True       # keep the stream visibly updating

            # Repaint only when something changed, while streaming, or every 0.4s
            # for the live stats — NOT 6×/second. This is what stops the refresh
            # from fighting your typing.
            now = time.monotonic()
            if dirty or busy or (now - last_render) >= 0.4:
                render(messages, input_buf, busy)
                last_render = now
                dirty = False

            # ── Keyboard: drain ALL buffered bytes so fast typing is never lost ─
            rlist, _, _ = select.select([sys.stdin], [], [], 0.08)
            if rlist:
                data = os.read(fd, 1024)
                if data == b"\x1b":          # lone Esc → quit
                    break
                if data[:1] == b"\x1b":      # arrow/function escape sequence → ignore
                    continue
                for ch in data.decode("utf-8", "ignore"):
                    if ch in ("\r", "\n"):   # Enter → send (ignored while busy)
                        if input_buf.strip() and not busy:
                            msg = input_buf.strip(); input_buf = ""
                            messages.append(("You", msg))
                            messages.append(("AI", ""))
                            with SL:
                                S["ai_partial"] = ""; S["ai_busy"] = True; S["ai_done"] = False
                            threading.Thread(target=run_ai, args=(msg,), daemon=True).start()
                    elif ch == "\x7f":       # Backspace
                        input_buf = input_buf[:-1]
                    elif ch.isprintable():
                        input_buf += ch
                dirty = True                 # echo typed chars immediately
            await asyncio.sleep(0)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        os.system("tput cnorm 2>/dev/null")   # restore cursor

if __name__ == "__main__":
    asyncio.run(main())
